PORT=3000
CORS_WHITELIST=http://localhost:5173,http://localhost:5174

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>/<base-de-datos>

# JWT
JWT_SECRET=generar-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1d

# Google OAuth: debe coincidir con el Client ID usado por el frontend
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# n8n chatbot webhook
N8N_CHAT_WEBHOOK_URL=http://localhost:5678/webhook/tu-webhook/chat
