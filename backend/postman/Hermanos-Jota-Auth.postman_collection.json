{
  "info": {
    "_postman_id": "d0e8c1f2-4c70-4e31-9c75-9b9b2dfc1a20",
    "name": "Hermanos Jota - Auth",
    "description": "Pruebas de registro, login, sesión mediante cookie HttpOnly, usuario autenticado y logout para la API de Hermanos Jota.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "testEmail",
      "value": "cliente.prueba@example.com"
    },
    {
      "key": "testPassword",
      "value": "PasswordSeguro123!"
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"phone\": \"11-1234-5678\",\n  \"address\": \"Av. Siempre Viva 123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registro exitoso o usuario ya registrado', function () {",
              "    pm.expect([201, 409]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    pm.test('La respuesta establece la cookie de autenticación', function () {",
              "        pm.expect(pm.response.cookies.has('hjAuthToken')).to.be.true;",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('La respuesta establece la cookie de autenticación', function () {",
              "    pm.expect(pm.response.cookies.has('hjAuthToken')).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Usuario autenticado', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.expect(json.user.email).to.eql(pm.collectionVariables.get('testEmail'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logout exitoso', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('La cookie de autenticación fue limpiada', function () {",
              "    const cookie = pm.response.cookies.get('hjAuthToken');",
              "    pm.expect(cookie).to.exist;",
              "    pm.expect(cookie.value).to.eql('');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
